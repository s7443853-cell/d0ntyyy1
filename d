.auth{max-width:420px;margin:10vh auto 0;padding:24px}.tabs{display:flex;gap:6px;margin-bottom:18px}.tabs button{flex:1}.field{display:flex;flex-direction:column;gap:7px;margin:12px 0}.field label{font-size:11px;color:var(--muted);font-weight:800;letter-spacing:.8px}.input,.field input,.field select,.field textarea{width:100%;background:#0f1115;color:#fff;border:1px solid var(--line);border-radius:9px;padding:11px 12px;outline:none}.field input:focus,.field select:focus,.field textarea:focus{border-color:#555d68}.btn{border:1px solid var(--line);background:#1a1e24;color:#fff;padding:11px 14px;border-radius:9px}.btn:hover{background:#242931}.btn-green{background:#173a27;border-color:#275f3e}.btn-red{background:#3b181c;border-color:#643035}.btn-blue{background:#17273f;border-color:#294d80}.btn-gold{background:#3b3217;border-color:#6c5b22}.stack{display:flex;gap:8px;flex-wrap:wrap}.error{color:#ff717b;font-size:13px;margin-top:8px}.ok{color:#68dc95;font-size:13px;margin-top:8px}
.plate-wrap{display:flex;justify-content:center;margin:25px 0 15px}.plate{width:min(620px,94vw);min-height:124px;display:flex;align-items:center;justify-content:center;gap:14px;padding:18px 24px;border-radius:18px;background:linear-gradient(180deg,#f7f7f7,#cfd2d6);color:#111;box-shadow:0 7px 30px rgba(255,255,255,.07),inset 0 2px 0 rgba(255,255,255,.95),inset 0 -3px 0 rgba(0,0,0,.15);border:4px solid #25272b;position:relative;overflow:hidden}.plate .main-code{font-weight:1000;font-size:clamp(40px,7vw,72px);letter-spacing:4px}.plate .region{font-weight:900;font-size:clamp(18px,3vw,28px);align-self:flex-start;margin-top:20px;border-left:2px solid #999;padding-left:12px}.plate.gold{box-shadow:0 0 0 2px rgba(255,214,91,.15),0 0 40px rgba(255,196,40,.35),inset 0 2px 0 #fff}.plate.rare{box-shadow:0 0 0 2px rgba(110,168,255,.14),0 0 34px rgba(90,140,255,.28),inset 0 2px 0 #fff}.rarity{font-size:13px;font-weight:800;letter-spacing:.5px}.rarity.gold{color:var(--gold)}.rarity.rare{color:var(--blue)}.rarity.common{color:#adb3bc}.spin-area{padding:24px}.spin-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.spin-grid button{min-height:58px;font-weight:900;letter-spacing:1px;border:1px solid var(--line);background:#15181d;color:#fff;border-radius:11px}.spin-grid button:hover{background:#20242a}.your-id{margin-top:10px;color:#777;font-size:12px}.balance{text-align:center;margin:12px 0;color:#c9cdd3}.info-row{display:flex;justify-content:center;gap:22px;flex-wrap:wrap;color:#a7adb6;font-size:13px}
.list{display:flex;flex-direction:column;gap:9px}.row{padding:15px;border:1px solid var(--line);border-radius:12px;background:#111318}.row-main{display:flex;justify-content:space-between;gap:14px;align-items:center}.mono{font-family:ui-monospace,Consolas,monospace}.badge{display:inline-flex;align-items:center;padding:5px 8px;border-radius:999px;border:1px solid var(--line);font-size:11px}.badge.green{color:#71dfa0;background:#10291b}.badge.red{color:#ff8a91;background:#301317}.badge.gold{color:#ffe184;background:#30270f}.badge.blue{color:#9fc3ff;background:#10223b}.muted{color:var(--muted)}
.two{display:grid;grid-template-columns:1fr 1fr;gap:16px}.three{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.section-title{font-size:18px;font-weight:900;margin-bottom:12px}.metric{padding:17px;border:1px solid var(--line);border-radius:12px;background:#111318}.metric b{display:block;font-size:24px;margin-top:5px}.small{font-size:12px}.center{text-align:center}.mt{margin-top:14px}.admin-overlay,.ban-overlay,.message-overlay{position:fixed;inset:0;z-index:100;background:rgba(3,4,5,.78);backdrop-filter:blur(10px);display:flex;align-items:center;justify-content:center;padding:18px}.admin-window{width:min(1400px,98vw);max-height:95vh;display:grid;grid-template-columns:270px 1fr;background:#0f1115;border:1px solid #30343b;border-radius:22px;box-shadow:0 30px 110px rgba(0,0,0,.72);overflow:hidden}.admin-side{padding:18px;border-right:1px solid var(--line);background:linear-gradient(180deg,#0b0d10,#101216)}.admin-side button{width:100%;text-align:left;margin-bottom:7px;padding:13px 15px;font-weight:800}.admin-side button.active{background:#191d23}.admin-content{padding:28px;overflow:auto}.tag-preview{display:inline-flex;align-items:center;min-height:30px;padding:5px 10px;border-radius:999px;border:1px solid var(--line);font-size:12px;font-weight:900}.tag-remove{white-space:nowrap}.admin-users-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px}.admin-report{padding:16px;border:1px solid var(--line);border-radius:14px;background:#111318}.admin-report + .admin-report{margin-top:12px}.admin-stat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.admin-stat-card{padding:16px;border:1px solid var(--line);border-radius:13px;background:#111318}.admin-stat-card strong{display:block;font-size:25px;margin-top:6px}.role-pill{display:inline-flex;align-items:center;padding:5px 9px;border:1px solid var(--line);border-radius:999px;background:#171a20;font-size:11px;font-weight:900}.online-dot{width:8px;height:8px;border-radius:50%;display:inline-block;margin-right:7px;background:#656a73}.online-dot.on{background:#43d17b;box-shadow:0 0 9px rgba(67,209,123,.55)}.answer-box{margin-top:12px;padding:12px;border-left:2px solid #3c4654;background:#0d1014;border-radius:8px}.promo-code{font-family:ui-monospace,Consolas,monospace;font-size:20px;font-weight:1000;letter-spacing:1px}.activation-list{margin-top:10px;padding-top:10px;border-top:1px solid var(--line)}.helper-note{padding:12px 14px;border:1px solid #294d80;background:#101c2d;border-radius:11px;color:#b9d2f6}.admin-user-card{padding:16px;border:1px solid var(--line);border-radius:14px;background:#111318}.tag-colors{display:grid;grid-template-columns:1fr 1fr;gap:12px}.check-row{display:flex;align-items:center;gap:9px;padding:12px;border:1px solid var(--line);border-radius:10px;background:#111318}.check-row input{width:18px;height:18px;accent-color:#6ea8ff}.close-x{position:absolute;right:26px;top:18px}.admin-head{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:18px}.admin-tab{display:none}.admin-tab.active{display:block}.subnav{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px}.subnav button.active{background:#262b33}.danger-note{padding:11px 12px;background:#1d1214;border:1px solid #4d262b;border-radius:10px;color:#ff9ba1}.success-note{padding:11px 12px;background:#112319;border:1px solid #214f32;border-radius:10px;color:#9be0b4}.admin-form{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.full{grid-column:1/-1}.hr{height:1px;background:var(--line);margin:16px 0}
.market-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:12px}.market-card{padding:14px;border:1px solid var(--line);border-radius:13px;background:#111318}.market-code{font-size:22px;font-weight:1000}.price{font-size:20px;font-weight:900;margin:10px 0}.inventory-item{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:13px;border:1px solid var(--line);border-radius:11px;background:#111318}.notice{padding:13px;border:1px solid var(--line);border-radius:11px;background:#111318}.notice.unread{border-color:#3f464f}.msg-list{display:flex;flex-direction:column;gap:9px}.msg{padding:14px;border:1px solid var(--line);border-radius:12px;background:#111318}.msg .title{font-weight:900;margin-bottom:8px}.msg pre{white-space:pre-wrap;font:inherit;color:#d4d7dc;margin:0}.searchbar{display:flex;gap:8px}.searchbar input{flex:1}.top-table{width:100%;border-collapse:collapse}.top-table th,.top-table td{padding:12px 10px;border-bottom:1px solid var(--line);text-align:left}.rank1{background:linear-gradient(90deg,rgba(255,214,91,.20),transparent)}.rank2{background:linear-gradient(90deg,rgba(210,215,224,.18),transparent)}.rank3{background:linear-gradient(90deg,rgba(194,131,80,.18),transparent)}
.ban-box{width:min(680px,95vw);background:#111318;border:1px solid #48282d;border-radius:18px;padding:28px;box-shadow:0 30px 100px rgba(0,0,0,.7);text-align:center}.ban-box h2{margin:0 0 16px;color:#ff7781}.ban-grid{text-align:left;display:grid;grid-template-columns:150px 1fr;gap:10px 12px;margin:18px 0}.ban-grid .label{color:#8f969f;font-size:12px;text-transform:uppercase;letter-spacing:.8px}.toast{position:fixed;right:18px;bottom:18px;z-index:150;width:min(390px,calc(100vw - 36px));padding:14px;border:1px solid var(--line);background:#15181d;border-radius:12px;box-shadow:0 20px 60px rgba(0,0,0,.45)}
@media(max-width:780px){.two,.three,.admin-form,.tag-colors,.admin-stat-grid{grid-template-columns:1fr}.admin-window{grid-template-columns:1fr;max-height:95vh}.admin-side{border-right:0;border-bottom:1px solid var(--line);display:flex;overflow:auto}.admin-side button{min-width:145px}.row-main{flex-direction:column;align-items:flex-start}.plate{gap:7px;padding:14px}.plate .main-code{letter-spacing:1px}}
