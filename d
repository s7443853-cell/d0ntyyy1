mt" style="padding:15px"><div class="section-title">НАКАЗАНИЯ</div><div class="list">${p.length?p.map(x=>`<div class="row"><div class="row-main"><div><b>${x.type==='warning'?'Предупреждение':x.type==='strike'?'Выговор':'Бан'}</b><div class="muted small">${esc(x.reason)}</div></div><span class="badge ${x.status==='active'?'red':'green'}">${esc(x.status)}</span></div><div class="small" style="margin-top:9px">Администратор: ${esc(x.admin)} · ID: <span class="mono">${x.id}</span> · Выдано: ${fmt(x.createdAt)}${x.expiresAt?' · До: '+fmt(x.expiresAt):' · Навсегда'}</div></div>`).join(''):'<div class="muted">Истории наказаний нет.</div>'}</div></div>`}

function openAdmin(){if(!currentUser||roleLevel(currentUser)<=0)return;document.getElementById('adminOverlay').classList.remove('hidden');renderAdmin()}
