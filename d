<body>
<div id="authView" class="page">
  <div class="card auth">
    <div class="brand" style="font-size:22px;margin-bottom:18px">D0NTYYY — LICENSE PLATES</div>
    <div class="tabs"><button class="btn" id="loginTab">Войти</button><button class="btn" id="registerTab">Регистрация</button></div>
