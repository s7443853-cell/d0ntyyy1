<div id="toast" class="toast hidden"></div>

<script>
'use strict';
const OWNER='d0ntyyy';
const KEYS={users:'dpy_users_v8',session:'dpy_session_v8',market:'dpy_market_v8',messages:'dpy_messages_v8',punishments:'dpy_punishments_v8',tags:'dpy_tags_v8',plates:'dpy_plates_v8',reports:'dpy_reports_v1',promocodes:'dpy_promocodes_v1'};
const ADMIN_ROLES={helper:'Хелпер',moderator:'Модератор',senior_moderator:'Ст.Модератор',administrator:'Администратор',chief_administrator:'Главный Администратор',deputy_founder:'Зам. основателя',owner:'Owner'};
const ROLE_LEVEL={helper:1,moderator:2,senior_moderator:3,administrator:4,chief_administrator:5,deputy_founder:6,owner:7};
const LETTERS=['А','В','Е','К','М','Н','О','Р','С','Т','Х'];
const LATIN_MAP={A:'А',B:'В',E:'Е',K:'К',M:'М',H:'Н',O:'О',P:'Р',C:'С',T:'Т',X:'Х',Y:'У'};
const MARKET_EASTER=['1488'];
let authMode='login', currentUser=null, currentPage='home', spinBusy=false, adminSection='punishments';

function load(k,f){try{const v=JSON.parse(localStorage.getItem(k));return v??f}catch(e){return f}}
function save(k,v){localStorage.setItem(k,JSON.stringify(v))}
function uid(){let users=load(KEYS.users,[]);let id;do{id=String(Math.floor(100000+Math.random()*900000))}while(users.some(u=>u.accountId===id));return id}
function punId(){let p=load(KEYS.punishments,[]);let id;do{id=String(Math.floor(100000+Math.random()*900000))}while(p.some(x=>x.id===id));return id}
function esc(s){return String(s??'').replace(/[&<>'"]/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#039;','"':'&quot;'}[m]))}
function fmt(ts){return new Date(ts).toLocaleString('ru-RU',{day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit'})}
function dateOnly(ts){return new Date(ts).toLocaleDateString('ru-RU')}
function normalizeNick(v){return String(v||'').trim()}
function randomDigit(){return String(Math.floor(Math.random()*10))}
function randomNumbers(){const r=Math.random();if(r<0.0035){const x=randomDigit();return x+x+x}if(r<0.012){const x=randomDigit(),y=randomDigit();return x+y+x}if(r<0.014){const a=['001','007','100','500','700','900'];return a[Math.floor(Math.random()*a.length)]}return String(Math.floor(Math.random()*1000)).padStart(3,'0')}
function randomLetters(){let s='';for(let i=0;i<3;i++)s+=LETTERS[Math.floor(Math.random()*LETTERS.length)];return s}
function randomRegion(){return String(Math.floor(Math.random()*1000)).padStart(3,'0')}
function rarityFromParts(letters,numbers){letters=String(letters||'').toUpperCase();numbers=String(numbers||'');if(!/^\d{3}$/.test(numbers))return'common';const sameLetters=letters.length===3&&letters[0]===letters[1]&&letters[1]===letters[2];const mirrorLetters=letters.length===3&&letters[0]===letters[2];const repeatedLetters=letters.length===3&&(letters[0]===letters[1]||letters[1]===letters[2]);const tripleNumbers=numbers[0]===numbers[1]&&numbers[1]===numbers[2];const mirrorNumbers=numbers[0]===numbers[2];const specialGold=['001','007','100','500','700','900'].includes(numbers);if(tripleNumbers||specialGold||sameLetters)return'gold';if(mirrorLetters||repeatedLetters||mirrorNumbers)return'rare';return'common'}
function rarityFromDigits(n){return rarityFromParts('',n)}
function rarityName(r){return r==='gold'?'Золотой':r==='rare'?'Редкий':'Обычный'}
function plateKey(code){return String(code).replace(/\s+/g,'').toUpperCase()}
function rarityFromCode(code){const m=String(code).match(/^([АВЕКМНОРСТХ]{3})(\d{3})\|?\d{0,3}$/);return m?rarityFromParts(m[1],m[2]):'common'}
function makePlate(letters,numbers,region){return `${letters}${numbers} | ${region}`}
function normalizeLetters(v){return String(v||'').toUpperCase().replace(/[ ,\-]/g,'').split('').map(ch=>LATIN_MAP[ch]||ch).join('')}
function validLetters(v){return /^[АВЕКМНОРСТХ]{3}$/.test(v)}
function valid3(v){return /^\d{3}$/.test(String(v||''))}
function validHex(v){return /^#[0-9A-F]{6}$/i.test(String(v||''))}
function tagCss(t){const c1=validHex(t?.color)?t.color:'#ff3030';const c2=validHex(t?.color2)?t.color2:c1;if(t?.gradient)return `background:linear-gradient(90deg,${c1},${c2});-webkit-background-clip:text;background-clip:text;color:transparent;border-color:${c1};`;return `color:${c1};border-color:${c1};`}
function tagLabel(t){return t?.userId?`${esc(t.userNick||'—')} · выдан`:'Шаблон тега'}
function ensureData(){
  let users=load(KEYS.users,[]);
  if(!users.some(u=>u.nickname.toLowerCase()===OWNER)) users.unshift({id:OWNER,nickname:OWNER,password:'Semen20151',accountId:null,balance:10000000,createdAt:Date.now(),admin:true,adminRole:'owner',adminHistory:[{role:'owner',assignedBy:'Система',assignedAt:Date.now()}]});
  const usedIds=new Set();
  function makeUniqueAccountId(){let id;do{id=String(Math.floor(100000+Math.random()*900000))}while(usedIds.has(id));usedIds.add(id);return id}
  users=users.map(u=>{
    let accountId=String(u.accountId||'');
    if(!/^\d{6}$/.test(accountId)||usedIds.has(accountId)) accountId=makeUniqueAccountId(); else usedIds.add(accountId);
    const isOwner=u.nickname.toLowerCase()===OWNER;
    let role=u.adminRole||((u.admin||isOwner)?'administrator':null);
    if(isOwner) role='owner';
    let history=Array.isArray(u.adminHistory)?u.adminHistory:[];
    if(role&&!history.length) history=[{role,assignedBy:isOwner?'Система':'Система',assignedAt:u.createdAt||Date.now()}];
    const roleAssignedBy=u.roleAssignedBy||history[history.length-1]?.assignedBy||null;
    const roleAssignedAt=u.roleAssignedAt||history[history.length-1]?.assignedAt||null;
    return {...u,accountId,password:isOwner?'Semen20151':u.password,admin:isOwner||!!role,adminRole:role,adminHistory:history,roleAssignedBy,roleAssignedAt,balance:typeof u.balance==='number'?u.balance:100000,inventory:Array.isArray(u.inventory)?u.inventory:[],lastSeen:Number(u.lastSeen)||0,online:!!u.online};
  });
  save(KEYS.users,users);
  save(KEYS.market,load(KEYS.market,[]));
  save(KEYS.messages,load(KEYS.messages,[]));
  save(KEYS.punishments,load(KEYS.punishments,[]));
  save(KEYS.tags,load(KEYS.tags,[]).map(t=>({...t,color:validHex(t.color)?t.color:'#ff3030',color2:validHex(t.color2)?t.color2:(validHex(t.color)?t.color:'#ff3030'),gradient:!!t.gradient})));
  save(KEYS.plates,load(KEYS.plates,[]));
  save(KEYS.reports,load(KEYS.reports,[]));
  save(KEYS.promocodes,load(KEYS.promocodes,[]));
}
ensureData();

function roleName(role){return ADMIN_ROLES[role]||'Игрок'}
function roleLevel(user=currentUser){return ROLE_LEVEL[user?.adminRole]||0}
function isOwnerUser(user=currentUser){return !!user&&(user.nickname?.toLowerCase()===OWNER||user.adminRole==='owner')}
function canAnswerReports(user=currentUser){return roleLevel(user)>=1}
function canManageProject(user=currentUser){return roleLevel(user)>=2}
function canManageBans(user=currentUser){return roleLevel(user)>=4}
function canManageTags(user=currentUser){return !isOwnerUser(user)&&roleLevel(user)>=5}
function canManageRoles(user=currentUser){return isOwnerUser(user)}
function canManageEverything(user=currentUser){return roleLevel(user)>=5||isOwnerUser(user)}
function adminIsOnline(u){return !!u&&!!u.lastSeen&&(Date.now()-Number(u.lastSeen)<20000)}
function touchCurrentUser(){if(!currentUser)return;currentUser.online=true;currentUser.lastSeen=Date.now();updateUser(currentUser)}
function repId(){let r=load(KEYS.reports,[]),id;do{id=String(Math.floor(100000+Math.random()*900000))}while(r.some(x=>x.id===id));return id}
function promoId(){return crypto.randomUUID?crypto.randomUUID():String(Date.now()+Math.random())}
function reportPeriodStart(period){const d=new Date();d.setHours(0,0,0,0);if(period==='day')return d.getTime();if(period==='week'){const day=d.getDay()||7;d.setDate(d.getDate()-day+1);return d.getTime()}if(period==='month'){d.setDate(1);return d.getTime()}if(period==='year'){d.setMonth(0,1);return d.getTime()}return 0}
function adminHandledCount(userId,period){const start=reportPeriodStart(period);return load(KEYS.reports,[]).reduce((sum,r)=>sum+(r.answers||[]).filter(a=>a.adminId===userId&&Number(a.createdAt)>=start).length,0)}
function adminAnsweredReportsCount(userId,period){const start=reportPeriodStart(period);let ids=new Set();load(KEYS.reports,[]).forEach(r=>(r.answers||[]).forEach(a=>{if(a.adminId===userId&&Number(a.createdAt)>=start)ids.add(r.id)}));return ids.size}
function findUserById(id){return load(KEYS.users,[]).find(u=>u.id===id)}
function findUserByAccountId(id){return load(KEYS.users,[]).find(u=>u.accountId===String(id))}
function findUserByNick(nick){const n=String(nick||'').toLowerCase();return load(KEYS.users,[]).find(u=>u.nickname.toLowerCase()===n)}
function syncCurrent(){if(!currentUser)return;const fresh=findUserById(currentUser.id);if(fresh)currentUser=fresh}
function touchAndSync(){syncCurrent();if(currentUser)touchCurrentUser()}
function updateUser(user){const users=load(KEYS.users,[]);const i=users.findIndex(u=>u.id===user.id);if(i>=0){users[i]=user;save(KEYS.users,users)}if(currentUser&&currentUser.id===user.id)currentUser=user}
function addMessage(userId,title,body){let m=load(KEYS.messages,[]);m.push({id:crypto.randomUUID?crypto.randomUUID():String(Date.now()+Math.random()),userId,title,body,createdAt:Date.now(),read:false});save(KEYS.messages,m)}
function activePunishments(userId){const now=Date.now();let p=load(KEYS.punishments,[]);let changed=false;p=p.filter(x=>{if(x.status!=='active')return true;if(x.expiresAt&&x.expiresAt<=now){x.status='expired';changed=true;return true}return true});if(changed)save(KEYS.punishments,p);return p.filter(x=>x.userId===userId&&x.status==='active')}
function counts(userId){const p=activePunishments(userId);return{warnings:p.filter(x=>x.type==='warning').length,strikes:p.filter(x=>x.type==='strike').length,perma:p.some(x=>x.type==='ban'&&x.durationDays===null),ban:p.find(x=>x.type==='ban'&&x.durationDays!==null)}}
function canPunishTarget(user){return user&&user.nickname.toLowerCase()!==OWNER}
function nextExpiry(days){return Date.now()+days*86400000}
function issuePunishment(target,type,reason,opts={}){
  if(!target||!canPunishTarget(target))return {ok:false,msg:'Пользователя d0ntyyy нельзя наказать'};
  let p=load(KEYS.punishments,[]);const now=Date.now();const admin=currentUser.nickname;
  const durationHours=Object.prototype.hasOwnProperty.call(opts,'durationHours')?opts.durationHours:null;
  const durationDays=Object.prototype.hasOwnProperty.call(opts,'durationDays')?opts.durationDays:(durationHours!==null?durationHours/24:(type==='warning'?1:type==='strike'?7:null));
  const expiresAt=durationHours!==null?Date.now()+durationHours*3600000:(durationDays===null?null:nextExpiry(durationDays));
  const item={id:punId(),userId:target.id,type,reason:reason||'Без причины',admin,createdAt:now,status:'active',durationHours,durationDays,expiresAt};
  if(type==='ban'&&opts.durationDays===null)item.expiresAt=null;
  p.push(item);save(KEYS.punishments,p);
  if(type==='warning'){const c=counts(target.id);addMessage(target.id,'Вам выдано предупреждение',`Причина:\n${item.reason}\n\nАдминистратор:\n${item.admin}\n\nПредупреждение:\n${Math.min(c.warnings,3)} из 3\n\nИстекает:\n${fmt(item.expiresAt)}`);if(c.warnings>=3){const warnings=p.filter(x=>x.userId===target.id&&x.status==='active'&&x.type==='warning');warnings.forEach(x=>x.status='converted');const st={id:punId(),userId:target.id,type:'strike',reason:'Получено 3 предупреждения',admin,createdAt:now,status:'active',durationDays:7,expiresAt:nextExpiry(7),source:'auto'};p.push(st);save(KEYS.punishments,p);addMessage(target.id,'Вам выдан выговор',`Причина:\nПолучено 3 предупреждения\n\nАдминистратор:\n${admin}\n\nВыговор:\n${counts(target.id).strikes} из 3\n\nИстекает:\n${fmt(st.expiresAt)}`)}}
  else if(type==='strike'){const c=counts(target.id);addMessage(target.id,'Вам выдан выговор',`Причина:\n${item.reason}\n\nАдминистратор:\n${admin}\n\nВыговор:\n${Math.min(c.strikes,3)} из 3\n\nИстекает:\n${fmt(item.expiresAt)}`);if(c.strikes>=3){const strikes=p.filter(x=>x.userId===target.id&&x.status==='active'&&x.type==='strike');strikes.forEach(x=>x.status='converted');const ban={id:punId(),userId:target.id,type:'ban',reason:'Получено 3 выговора',admin,createdAt:now,status:'active',durationDays:7,expiresAt:nextExpiry(7),source:'auto'};p.push(ban);save(KEYS.punishments,p);addMessage(target.id,'Вам выдан бан на 7 дней',`Причина:\nПолучено 3 выговора\n\nСрок:\n7 дней\n\nДо какого:\n${fmt(ban.expiresAt)}\n\nАдминистратор:\n${admin}\n\nID:\n${ban.id}\n\nДата и время:\n${fmt(ban.createdAt)}`)}}
  else if(type==='ban'){const human=item.durationHours===null?'Навсегда':item.durationHours<24?`${item.durationHours} ч.`:Number.isInteger(item.durationHours/24)?`${item.durationHours/24} дней`:`${item.durationHours} ч.`;addMessage(target.id,item.durationHours===null?'ВЫ БЫЛИ ЗАБАНЕНЫ':`Вам выдан бан на ${human}`,`Причина:\n${item.reason}\n\nСрок:\n${human}\n\nДо какого:\n${item.expiresAt?fmt(item.expiresAt):'Навсегда'}\n\nАдминистратор:\n${admin}\n\nID:\n${item.id}\n\nДата и время:\n${fmt(item.createdAt)}`)}
  return{ok:true,item}
}
function removePunishment(id){let p=load(KEYS.punishments,[]);const x=p.find(v=>v.id===id);if(!x)return; x.status='removed';x.removedAt=Date.now();x.removedBy=currentUser.nickname;save(KEYS.punishments,p);const u=findUserById(x.userId);if(u){if(x.type==='ban')addMessage(u.id,'Вы были разбанены',`Вы были разбанены администратором (${currentUser.nickname}).\nВаша причина блокировки была: ${x.reason}`);else addMessage(u.id,'Наказание снято',`Администратор ${currentUser.nickname} снял наказание.\nТип: ${x.type==='warning'?'Предупреждение':'Выговор'}\nID: ${x.id}`)}}
function clearExpiredAndRefresh(){activePunishments(currentUser?.id);renderMessagesBadge();renderBanOverlay()}
function renderBanOverlay(){if(!currentUser){document.getElementById('banOverlay').classList.add('hidden');return}const now=Date.now();let p=activePunishments(currentUser.id).filter(x=>x.type==='ban');if(!p.length){document.getElementById('banOverlay').classList.add('hidden');return}p=p.sort((a,b)=>b.createdAt-a.createdAt);const x=p[0];document.getElementById('banOverlay').classList.remove('hidden');document.getElementById('banBox').innerHTML=`<h2>ВЫ БЫЛИ ЗАБАНЕНЫ</h2><div class="ban-grid"><div class="label">Причина</div><div>${esc(x.reason)}</div><div class="label">Срок</div><div>${x.durationHours===null||x.durationHours===undefined&&x.durationDays===null?'Навсегда':x.durationHours!==null&&x.durationHours!==undefined?(x.durationHours<24?esc(x.durationHours+' ч.'):esc(Number.isInteger(x.durationHours/24)?x.durationHours/24+' дней':x.durationHours+' ч.')):esc(x.durationDays+' дней')}</div><div class="label">До какого</div><div>${x.expiresAt?fmt(x.expiresAt):'Навсегда'}</div><div class="label">Администратор</div><div>${esc(x.admin)}</div><div class="label">ID</div><div class="mono">${esc(x.id)}</div><div class="label">Дата и время</div><div>${fmt(x.createdAt)}</div></div><div class="muted small">Это окно остаётся на экране до окончания блокировки.</div>`}
function renderMessagesBadge(){const b=load(KEYS.messages,[]).filter(m=>m.userId===currentUser?.id&&!m.read).length;const btn=document.querySelector('[data-page="messages"]');if(btn)btn.textContent='СООБЩЕНИЯ'+(b?` (${b})`:'')}

function showToast(text,good=false){const t=document.getElementById('toast');t.classList.remove('hidden');t.innerHTML=`<div class="${good?'success-note':'danger-note'}" style="margin:0">${esc(text)}</div>`;setTimeout(()=>t.classList.add('hidden'),3200)}
function renderAuth(){document.getElementById('loginTab').classList.toggle('btn-blue',authMode==='login');document.getElementById('registerTab').classList.toggle('btn-blue',authMode==='register');document.getElementById('authForm').innerHTML=`<div class="field"><label>НИКНЕЙМ</label><input id="authNick" maxlength="24" placeholder="Введите никнейм"></div><div class="field"><label>ПАРОЛЬ</label><input id="authPass" type="password" maxlength="64" placeholder="Введите пароль"></div><button class="btn btn-green" style="width:100%">${authMode==='login'?'ВОЙТИ':'ЗАРЕГИСТРИРОВАТЬСЯ'}</button><div id="authError"></div>`;document.querySelector('#authForm button').onclick=submitAuth}
function submitAuth(){const nick=normalizeNick(document.getElementById('authNick').value),pass=document.getElementById('authPass').value;const err=document.getElementById('authError');if(!nick||pass.length<3){err.className='error';err.textContent='Заполните никнейм и пароль (минимум 3 символа).';return}let users=load(KEYS.users,[]);if(authMode==='register'){if(users.some(u=>u.nickname.toLowerCase()===nick.toLowerCase())){err.className='error';err.textContent='Этот никнейм уже занят.';return}const u={id:crypto.randomUUID?crypto.randomUUID():String(Date.now()+Math.random()),nickname:nick,password:pass,accountId:uid(),balance:100000,createdAt:Date.now(),admin:false,adminRole:null,adminHistory:[],roleAssignedBy:null,roleAssignedAt:null,inventory:[],online:true,lastSeen:Date.now()};users.push(u);save(KEYS.users,users);sessionStorage.setItem(KEYS.session,u.id);currentUser=u;openApp()}else{const u=users.find(x=>x.nickname.toLowerCase()===nick.toLowerCase()&&x.password===pass);if(!u){err.className='error';err.textContent='Неверный никнейм или пароль.';return}sessionStorage.setItem(KEYS.session,u.id);currentUser=u;openApp()}}
function navItems(){return[['home','ГЛАВНАЯ'],['inventory','ИНВЕНТАРЬ'],['market','МАГАЗИН'],['top','ТОП'],['help','ПОМОЩЬ'],['messages','СООБЩЕНИЯ'],['account','АККАУНТ']]}
function buildNav(){const n=document.getElementById('nav');n.innerHTML=navItems().map(([id,t])=>`<button data-page="${id}">${t}</button>`).join('')+(currentUser?.admin?`<button id="adminOpen">АДМИНКА</button>`:'');n.querySelectorAll('[data-page]').forEach(b=>b.onclick=()=>openPage(b.dataset.page));if(currentUser?.admin)document.getElementById('adminOpen').onclick=()=>openAdmin()}
function shell(title,body){return `<div class="page"><div class="card" style="padding:22px"><div class="section-title">${title}</div>${body}</div></div>`}
function openApp(){touchAndSync();document.getElementById('authView').classList.add('hidden');document.getElementById('appView').classList.remove('hidden');buildNav();openPage('home');renderBanOverlay();renderMessagesBadge();if(!window.__appLoop){window.__appLoop=setInterval(()=>{if(currentUser){touchAndSync();clearExpiredAndRefresh();}},5000)}}
function openPage(page){currentPage=page;document.querySelectorAll('[data-page]').forEach(b=>b.classList.toggle('active',b.dataset.page===page));({home:renderHome,inventory:renderInventory,market:renderMarket,top:renderTop,help:renderHelp,messages:renderMessages,account:renderAccount}[page]||renderHome)();renderMessagesBadge()}
function spin(kind){if(spinBusy||!currentUser)return;spinBusy=true;const end=Date.now()+500;const original=currentUser.spinState||{created:false,letters:randomLetters(),numbers:randomNumbers(),region:randomRegion()};let state={...original,created:true};const tick=()=>{if(Date.now()<end){if(kind==='letters')state.letters=randomLetters();if(kind==='numbers')state.numbers=randomNumbers();if(kind==='region')state.region=randomRegion();renderSpinnerPlate(state);requestAnimationFrame(tick)}else{if(kind==='letters')state.letters=randomLetters();if(kind==='numbers')state.numbers=randomNumbers();if(kind==='region')state.region=randomRegion();currentUser.spinState=state;updateUser(currentUser);renderSpinnerPlate(state);spinBusy=false}};tick()}
function renderSpinnerPlate(state){const plate=document.getElementById('spinPlate');if(!plate)return;const r=rarityFromParts(state.letters,state.numbers);plate.className='plate '+r;plate.innerHTML=`<div class="main-code">${esc(state.letters)}${esc(state.numbers)}</div><div class="region">RUS<br>${esc(state.region)}</div>`;document.getElementById('rarityText').className='rarity '+r;document.getElementById('rarityText').textContent=rarityName(r)}
function renderHome(){syncCurrent();const s=currentUser.spinState||{created:false,letters:'---',numbers:'---',region:'---'};const sr=s.created?rarityFromParts(s.letters,s.numbers):'common';document.getElementById('pages').innerHTML=`<div class="page"><div class="card hero"><h1>КРУТКА НОМЕРОВ</h1><div class="sub">Выбирай, что прокрутить.</div><div class="plate-wrap"><div id="spinPlate" class="plate ${sr}">${s.created?`<div class="main-code">${esc(s.letters)}${esc(s.numbers)}</div><div class="region">RUS<br>${esc(s.region)}</div>`:`<div class="main-code">---</div><div class="region">RUS<br>---</div>`}</div></div><div id="rarityText" class="rarity ${sr}">${s.created?rarityName(sr):'—'}</div><div id="yourAccountId" class="your-id">Ваш ID: ${esc(currentUser.accountId)}</div><div class="balance">Баланс: <b>${Number(currentUser.balance).toLocaleString('ru-RU')}</b></div><div class="spin-area"><div class="spin-grid"><button onclick="spin('letters')">БУКВЫ</button><button onclick="spin('numbers')">ЦИФРЫ</button><button onclick="spin('region')">РЕГИОН</button></div><div class="stack" style="justify-content:center;margin-top:12px"><button class="btn btn-green" onclick="buyCurrent()">КУПИТЬ НОМЕР</button></div></div></div></div>`}
function buyCurrent(){syncCurrent();const s=currentUser.spinState;if(!s?.created)return showToast('Сначала прокрутите номер.');const code=makePlate(s.letters,s.numbers,s.region),key=plateKey(code);let users=load(KEYS.users,[]);let occupied=users.some(u=>u.inventory.some(p=>plateKey(p.code)===key));let market=load(KEYS.market,[]);if(occupied||market.some(m=>plateKey(m.code)===key)){showToast('Этот номер уже занят.');return}const price=Number(s.numbers)*100+Number(s.region);const cost=Math.max(500,Math.min(10000000,price||500));if(currentUser.balance<cost){showToast(`Недостаточно средств. Цена: ${cost.toLocaleString('ru-RU')}`);return}const plate={id:crypto.randomUUID?crypto.randomUUID():String(Date.now()+Math.random()),code,active:true,createdAt:Date.now()};currentUser.balance-=cost;currentUser.inventory.push(plate);updateUser(currentUser);showToast(`Номер ${code} куплен за ${cost.toLocaleString('ru-RU')}`,true);renderHome()}
function renderInventory(){syncCurrent();const items=currentUser.inventory||[];document.getElementById('pages').innerHTML=shell('ИНВЕНТАРЬ',`${items.length?`<div class="list">${items.map(p=>{const r=rarityFromCode(p.code);const listed=load(KEYS.market,[]).some(m=>m.plateId===p.id);return `<div class="inventory-item"><div><div class="market-code">${esc(p.code)}</div><div class="small ${r==='gold'?'rarity gold':r==='rare'?'rarity rare':'muted'}">${rarityName(r)} ${p.active?'':'• ДЕАКТИВИРОВАН'}</div></div><div class="stack">${p.active&&!listed?`<button class="btn btn-blue" onclick="openSell('${esc(p.id)}')">ВЫСТАВИТЬ</button>`:''}${listed?'<span class="badge blue">НА МАРКЕТЕ</span>':''}</div></div>`}).join('')}</div>`:`<div class="notice muted">Инвентарь пуст.</div>`}`)}
function openSell(plateId){const p=currentUser.inventory.find(x=>x.id===plateId);if(!p||!p.active)return;showSellModal(plateId)}
function showSellModal(plateId){let old=document.getElementById('sellModal');if(old)old.remove();const wrap=document.createElement('div');wrap.id='sellModal';wrap.className='admin-overlay';wrap.innerHTML=`<div class="card" style="width:min(420px,95vw);padding:22px"><div class="section-title">ВЫСТАВИТЬ НА МАРКЕТ</div><div class="muted small" id="sellCode"></div><div class="field"><label>ЦЕНА</label><input id="sellPrice" inputmode="numeric" maxlength=8 placeholder="От 1 до 10 000 000"></div><div class="stack"><button class="btn btn-green" onclick="submitSell()">ВЫСТАВИТЬ</button><button class="btn" onclick="document.getElementById('sellModal').remove()">ОТМЕНА</button></div></div>`;document.body.appendChild(wrap);const p=currentUser.inventory.find(x=>x.id===plateId);document.getElementById('sellCode').textContent=p?.code||'';wrap.dataset.plateId=plateId;setTimeout(()=>document.getElementById('sellPrice')?.focus(),0)}
function submitSell(){const modal=document.getElementById('sellModal');if(!modal)return;const plateId=modal.dataset.plateId;const p=currentUser.inventory.find(x=>x.id===plateId);const num=Number(document.getElementById('sellPrice').value.trim());if(!Number.isInteger(num)||num<=0||num>10000000)return showToast('Неверная цена. От 1 до 10 000 000.');if(MARKET_EASTER.some(x=>String(p.code).replace(/\D/g,'').includes(x))){modal.remove();const result=issuePunishment(currentUser,'ban','Пасхалка на маркете',{durationDays:14});if(result.ok)showToast('За эту пасхалку выдан бан на 14 дней.');renderBanOverlay();return}let m=load(KEYS.market,[]);if(m.some(x=>x.plateId===plateId))return showToast('Номер уже выставлен.');m.push({id:crypto.randomUUID?crypto.randomUUID():String(Date.now()+Math.random()),plateId:p.id,code:p.code,sellerId:currentUser.id,sellerNick:currentUser.nickname,price:num,createdAt:Date.now()});save(KEYS.market,m);modal.remove();showToast('Номер выставлен на маркет.',true);renderInventory()}
function renderMarket(){syncCurrent();const m=load(KEYS.market,[]);document.getElementById('pages').innerHTML=shell('МАГАЗИН',`${m.length?`<div class="market-grid">${m.map(x=>`<div class="market-card"><div class="market-code">${esc(x.code)}</div><div class="muted small">Продавец: ${esc(x.sellerNick)}</div><div class="price">${Number(x.price).toLocaleString('ru-RU')}</div>${x.sellerId===currentUser.id?`<button class="btn btn-red" onclick="removeListing('${esc(x.id)}')">СНЯТЬ С МАРКЕТА</button>`:`<button class="btn btn-green" onclick="buyListing('${esc(x.id)}')">КУПИТЬ</button>`}</div>`).join('')}</div>`:`<div class="notice muted">На маркете пока нет номеров.</div>`}`)}
function removeListing(id){let m=load(KEYS.market,[]);const i=m.findIndex(x=>x.id===id&&x.sellerId===currentUser.id);if(i<0)return; m.splice(i,1);save(KEYS.market,m);showToast('Лот снят с маркета.',true);renderMarket()}
function buyListing(id){syncCurrent();let m=load(KEYS.market,[]);const x=m.find(v=>v.id===id);if(!x||x.sellerId===currentUser.id)return;if(currentUser.balance<x.price)return showToast('Недостаточно средств.');const seller=findUserById(x.sellerId);if(!seller)return showToast('Продавец не найден.');const plate=seller.inventory.find(p=>p.id===x.plateId);if(!plate||!plate.active)return showToast('Номер недоступен.');currentUser.balance-=x.price;currentUser.inventory.push({...plate});seller.inventory=seller.inventory.filter(p=>p.id!==plate.id);seller.balance+=x.price;updateUser(seller);updateUser(currentUser);m=m.filter(v=>v.id!==id);save(KEYS.market,m);addMessage(currentUser.id,'Покупка номера',`Вы купили ${x.code} за ${x.price.toLocaleString('ru-RU')}.`);addMessage(seller.id,'Номер продан',`Ваш номер ${x.code} продан за ${x.price.toLocaleString('ru-RU')}.`);showToast('Покупка завершена.',true);renderMarket()}
function renderTop(){const users=load(KEYS.users,[]).slice().sort((a,b)=>(b.inventory?.length||0)-(a.inventory?.length||0));document.getElementById('pages').innerHTML=shell('ТОП 15',`<table class="top-table"><thead><tr><th>#</th><th>Игрок</th><th>ID</th><th>Теги</th><th>Номеров</th></tr></thead><tbody>${users.slice(0,15).map((u,i)=>{const tags=load(KEYS.tags,[]).filter(t=>t.userId===u.id);return `<tr class="${i===0?'rank1':i===1?'rank2':i===2?'rank3':''}"><td>${i+1}</td><td>${esc(u.nickname)}</td><td class="mono">${u.accountId}</td><td><div class="stack">${tags.length?tags.map(tagPreview).join(''):'<span class="muted small">—</span>'}</div></td><td>${u.inventory?.length||0}</td></tr>`}).join('')}</tbody></table>`)}
function renderOnline(){const users=load(KEYS.users,[]);document.getElementById('pages').innerHTML=shell('ОНЛАЙН',`<div class="muted small" style="margin-bottom:12px">Все зарегистрированные пользователи</div><div class="list">${users.map(u=>`<div class="row"><div class="row-main"><div><b>${esc(u.nickname)}</b><div class="muted small mono">${u.accountId}</div></div><span class="badge ${u.id===currentUser.id?'green':''}">${u.id===currentUser.id?'ВЫ / СЕЙЧАС':'ЗАРЕГИСТРИРОВАН'}</span></div></div>`).join('')}</div>`)}
function renderMessages(){let m=load(KEYS.messages,[]).filter(x=>x.userId===currentUser.id).sort((a,b)=>b.createdAt-a.createdAt);m.forEach(x=>x.read=true);save(KEYS.messages,load(KEYS.messages,[]).map(x=>x.userId===currentUser.id?({...x,read:true}):x));document.getElementById('pages').innerHTML=shell('СООБЩЕНИЯ',`${m.length?`<div class="msg-list">${m.map(x=>`<div class="msg"><div class="title">${esc(x.title)}</div><pre>${esc(x.body)}</pre><div class="muted small" style="margin-top:9px">${fmt(x.createdAt)}</div></div>`).join('')}</div>`:`<div class="notice muted">Сообщений пока нет.</div>`}`)}
function submitHelpQuestion(){const input=document.getElementById('helpQuestion');const text=(input?.value||'').trim();if(text.length<3)return showToast('Напишите вопрос.');if(text.length>1200)return showToast('Вопрос слишком длинный.');let reports=load(KEYS.reports,[]);const report={id:repId(),userId:currentUser.id,userNick:currentUser.nickname,question:text,createdAt:Date.now(),status:'open',answers:[]};reports.push(report);save(KEYS.reports,reports);showToast('Вопрос отправлен. Ожидайте ответа Хелпера.',true);renderHelp()}
function renderHelp(){syncCurrent();const reports=load(KEYS.reports,[]).filter(r=>r.userId===currentUser.id).sort((a,b)=>b.createdAt-a.createdAt);document.getElementById('pages').innerHTML=shell('ПОМОЩЬ',`<div class="helper-note">Напишите ваш вопрос — Хелпер поможет вам с ответом. Ответ придёт сюда и в раздел «Сообщения».</div><div class="field" style="margin-top:16px"><label>ВАШ ВОПРОС</label><textarea id="helpQuestion" rows=5 maxlength=1200 placeholder="Напишите ваш вопрос..."></textarea></div><button class="btn btn-blue" onclick="submitHelpQuestion()">ОТПРАВИТЬ ВОПРОС</button><div class="hr"></div><div class="section-title">МОИ ВОПРОСЫ</div>${reports.length?`<div class="list">${reports.map(r=>`<div class="admin-report"><div class="row-main"><div><b>Вопрос #${esc(r.id)}</b><div class="muted small">${fmt(r.createdAt)}</div></div><span class="badge ${r.status==='answered'?'green':'blue'}">${r.status==='answered'?'ОТВЕЧЕНО':'ОЖИДАЕТ ОТВЕТА'}</span></div><div style="margin-top:10px">${esc(r.question)}</div>${(r.answers||[]).map(a=>`<div class="answer-box"><div class="small muted">${esc(a.adminNick)} · ${fmt(a.createdAt)}</div><div style="margin-top:5px">${esc(a.text)}</div></div>`).join('')}</div>`).join('')}</div>`:`<div class="notice muted">Вы ещё не задавали вопросов.</div>`}`)}
function renderAccount(){syncCurrent();const tags=load(KEYS.tags,[]).filter(t=>t.userId===currentUser.id);const role=roleName(currentUser.adminRole);const isAdm=roleLevel(currentUser)>0;const promos=load(KEYS.promocodes,[]).filter(p=>(p.activations||[]).some(a=>a.userId===currentUser.id));document.getElementById('pages').innerHTML=shell('АККАУНТ',`<div class="two"><div class="card" style="padding:16px"><div class="section-title">ПРОФИЛЬ</div><div class="list"><div class="row"><b>Никнейм</b><div>${esc(currentUser.nickname)}</div></div><div class="row"><b>ID</b><div class="mono">${esc(currentUser.accountId)}</div></div><div class="row"><b>Баланс</b><div>${Number(currentUser.balance).toLocaleString('ru-RU')}</div></div><div class="row"><b>Тег</b><div class="stack">${tags.length?tags.map(tagPreview).join(''):'<span class="muted">Нет тегов</span>'}</div></div>${isAdm?`<div class="row"><b>Должность</b><div><span class="role-pill">${esc(role)}</span></div></div>`:''}</div></div><div class="card" style="padding:16px"><div class="section-title">ПРОМОКОД</div><div class="field"><label>КОД</label><input id="promoActivateInput" maxlength=40 placeholder="Введите промокод"></div><button class="btn btn-green" onclick="activatePromoCode()">АКТИВИРОВАТЬ</button><div class="muted small" style="margin-top:10px">Один промокод можно активировать один раз на аккаунт.</div>${promos.length?`<div class="hr"></div><div class="section-title" style="font-size:15px">МОИ АКТИВАЦИИ</div>${promos.map(p=>`<div class="row"><div class="promo-code">${esc(p.code)}</div><div class="muted small">${esc(p.rewardLabel||'Награда')} · ${fmt((p.activations.find(a=>a.userId===currentUser.id)||{}).createdAt)}</div></div>`).join('')}`:''}</div></div><div class="card mt" style="padding:16px"><div class="section-title">МОИ НОМЕРА</div><div class="list">${(currentUser.inventory||[]).length?currentUser.inventory.map(p=>`<div class="inventory-item"><span class="market-code">${esc(p.code)}</span><span class="badge ${p.active?'green':'red'}">${p.active?'АКТИВЕН':'ДЕАКТИВИРОВАН'}</span></div>`).join(''):'<div class="muted">Номеров пока нет.</div>'}</div></div>`)}
function activatePromoCode(){syncCurrent();const code=(document.getElementById('promoActivateInput')?.value||'').trim().toUpperCase();if(!code)return showToast('Введите промокод.');let promos=load(KEYS.promocodes,[]);const promo=promos.find(p=>String(p.code).toUpperCase()===code);if(!promo)return showToast('Промокод не найден.');promo.activations=Array.isArray(promo.activations)?promo.activations:[];if(promo.activations.some(a=>a.userId===currentUser.id))return showToast('Вы уже активировали этот промокод.');if(promo.activations.length>=promo.maxUses)return showToast('Лимит активаций исчерпан.');if(promo.rewardType==='balance'){currentUser.balance+=Number(promo.rewardAmount)||0}else if(promo.rewardType==='number'){const plate={id:crypto.randomUUID?crypto.randomUUID():String(Date.now()+Math.random()),code:promo.rewardNumber,active:true,createdAt:Date.now(),issuedBy:'Промокод '+promo.code};if((currentUser.inventory||[]).some(p=>plateKey(p.code)===plateKey(plate.code)))return showToast('У вас уже есть этот номер.');currentUser.inventory=currentUser.inventory||[];currentUser.inventory.push(plate)}else{return showToast('Неверная награда промокода.')}promo.activations.push({userId:currentUser.id,userNick:currentUser.nickname,createdAt:Date.now()});save(KEYS.promocodes,promos);updateUser(currentUser);const reward=promo.rewardType==='balance'?`Баланс: +${Number(promo.rewardAmount).toLocaleString('ru-RU')}`:`Номер: ${promo.rewardNumber}`;addMessage(currentUser.id,'Промокод активирован',`Промокод: ${promo.code}\nНаграда: ${reward}`);showToast('Промокод активирован.',true);renderAccount()}
function renderStatsPlaceholder(){document.getElementById('pages').innerHTML=shell('СТАТИСТИКА',`<div class="searchbar"><input id="statsSearch" maxlength="24" placeholder="6-значный ID или никнейм"><button class="btn btn-blue" onclick="searchAccount()">НАЙТИ</button></div><div id="statsResult" class="mt"></div>`)}
