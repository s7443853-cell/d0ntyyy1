function renderAdmin(){const tabs=adminTabsForCurrent();if(!tabs.some(x=>x[0]===adminSection))adminSection=tabs[0][0];document.getElementById('adminSide').innerHTML=tabs.map(([id,t])=>`<button class="btn ${adminSection===id?'active':''}" onclick="adminSection='${id}';renderAdmin()">${t}</button>`).join('');const subtitle=roleName(currentUser.adminRole)+` · ${currentUser.nickname}`;document.querySelector('#adminOverlay .admin-head .muted').textContent=subtitle;const views={reports:adminReports,stats:adminStats,punishments:adminPunishments,numbers:adminNumbers,users:adminUsers,tags:adminTags,promocodes:adminPromocodes,online:adminOnline,roles:adminRoles};document.getElementById('adminTabs').innerHTML=views[adminSection]()}
function userSelect(id='punUser',includeOwner=true){return `<select id="${id}">${load(KEYS.users,[]).map(u=>{const owner=u.nickname.toLowerCase()===OWNER;return `<option value="${esc(u.id)}" ${!includeOwner&&owner?'disabled':''}>${esc(u.nickname)} — ${u.accountId}${owner?' · OWNER':''}</option>`}).join('')}</select>`}
function adminReports(){if(!canAnswerReports())return '<div class="notice muted">Нет доступа.</div>';const reports=load(KEYS.reports,[]).slice().sort((a,b)=>(a.status==='open'?0:1)-(b.status==='open'?0:1)||b.createdAt-a.createdAt);return `<div class="admin-tab active"><div class="section-title">РЕПОРТЫ / ПОМОЩЬ</div><div class="muted small" style="margin-bottom:14px">Хелпер отвечает на вопросы игроков. Все должности выше Хелпера тоже могут отвечать.</div>${reports.length?reports.map(r=>`<div class="admin-report"><div class="row-main"><div><b>Вопрос #${esc(r.id)}</b><div class="muted small">${esc(r.userNick)} · ID ${esc(findUserById(r.userId)?.accountId||'—')} · ${fmt(r.createdAt)}</div></div><span class="badge ${r.status==='answered'?'green':'blue'}">${r.status==='answered'?'ОТВЕЧЕНО':'ОЖИДАЕТ ОТВЕТА'}</span></div><div style="margin-top:11px;font-size:15px">${esc(r.question)}</div>${(r.answers||[]).map(a=>`<div class="answer-box"><div class="small muted">${esc(a.adminNick)} · ${fmt(a.createdAt)}</div><div style="margin-top:5px">${esc(a.text)}</div></div>`).join('')}<div class="field"><label>ОТВЕТ</label><textarea id="answer_${esc(r.id)}" rows=3 maxlength=1200 placeholder="Напишите ответ игроку..."></textarea></div><button class="btn btn-green" onclick="answerReport('${esc(r.id)}')">ОТВЕТИТЬ</button></div>`).join(''):`<div class="notice muted">Репортов пока нет.</div>`}</div>`}
function answerReport(id){if(!canAnswerReports())return showToast('Нет доступа.');const text=(document.getElementById('answer_'+id)?.value||'').trim();if(text.length<2)return showToast('Напишите ответ.');let reports=load(KEYS.reports,[]);const r=reports.find(x=>x.id===id);if(!r)return showToast('Репорт не найден.');r.answers=Array.isArray(r.answers)?r.answers:[];const now=Date.now();r.answers.push({id:crypto.randomUUID?crypto.randomUUID():String(now+Math.random()),adminId:currentUser.id,adminNick:currentUser.nickname,text,createdAt:now});r.status='answered';r.lastAnsweredAt=now;r.lastAnsweredBy=currentUser.nickname;save(KEYS.reports,reports);addMessage(r.userId,'Вам ответили на ваш вопрос',`Ник: ${currentUser.nickname}\nОтвет: ${text}`);showToast('Ответ отправлен игроку.',true);renderAdmin()}
function adminStats(){const admins=load(KEYS.users,[]).filter(u=>roleLevel(u)>0).sort((a,b)=>roleLevel(b)-roleLevel(a)||a.nickname.localeCompare(b.nickname,'ru'));const own=currentUser;return `<div class="admin-tab active"><div class="section-title">АДМИН-СТАТИСТИКА</div><div class="card" style="padding:16px;margin-bottom:14px"><div class="row-main"><div><b>${esc(own.nickname)}</b><div class="muted small">${esc(own.accountId)} · ${esc(roleName(own.adminRole))}</div></div><span class="badge ${adminIsOnline(own)?'green':'red'}"><span class="online-dot ${adminIsOnline(own)?'on':''}"></span>${adminIsOnline(own)?'ОНЛАЙН':'ОФЛАЙН'}</span></div><div class="small" style="margin-top:10px">Назначен на текущую должность: ${fmt(own.roleAssignedAt||own.createdAt)} · Назначил: ${esc(own.roleAssignedBy||'Система')}</div></div><div class="admin-stat-grid">${[['ДЕНЬ','day'],['НЕДЕЛЯ','week'],['МЕСЯЦ','month'],['ГОД','year']].map(([label,key])=>`<div class="admin-stat-card"><div class="muted small">${label}</div><strong>${adminAnsweredReportsCount(own.id,key)}</strong><div class="muted small">отработано вопросов</div></div>`).join('')}</div><div class="hr"></div><div class="section-title">ПОИСК АДМИНА</div><div class="searchbar"><input id="adminStatsSearch" maxlength=24 placeholder="6-значный ID или никнейм"><button class="btn btn-blue" onclick="adminSearchAdmin()">НАЙТИ</button></div><div id="adminAdminResult" class="mt"></div><div class="hr"></div><div class="section-title">ВСЕ АДМИНЫ</div><div class="list">${admins.map(u=>`<div class="row"><div class="row-main"><div><b>${esc(u.nickname)}</b><div class="muted small">ID ${esc(u.accountId)} · ${esc(roleName(u.adminRole))}</div></div><span class="badge ${adminIsOnline(u)?'green':'red'}">${adminIsOnline(u)?'ОНЛАЙН':'ОФЛАЙН'}</span></div><div class="small" style="margin-top:8px">Вопросов за месяц: ${adminAnsweredReportsCount(u.id,'month')} · Номеров: ${(u.inventory||[]).length}</div></div>`).join('')}</div></div>`}
function adminSearchAdmin(){const q=(document.getElementById('adminStatsSearch')?.value||'').trim();const u=/^\d{6}$/.test(q)?findUserByAccountId(q):findUserByNick(q);const box=document.getElementById('adminAdminResult');if(!u||roleLevel(u)<=0){box.innerHTML='<div class="notice muted">Администратор не найден.</div>';return}const history=Array.isArray(u.adminHistory)?u.adminHistory:[];const tags=load(KEYS.tags,[]).filter(t=>t.userId===u.id);const active=(u.inventory||[]).filter(p=>p.active).length;const inactive=(u.inventory||[]).filter(p=>!p.active).length;box.innerHTML=`<div class="card" style="padding:16px"><div class="row-main"><div><b>${esc(u.nickname)}</b><div class="muted small">ID ${esc(u.accountId)}</div></div><span class="role-pill">${esc(roleName(u.adminRole))}</span></div><div class="two" style="margin-top:14px"><div class="row"><b>Кто назначил</b><div>${esc(u.roleAssignedBy||'Система')}</div><div class="muted small">${fmt(u.roleAssignedAt||u.createdAt)}</div></div><div class="row"><b>Текущая должность</b><div>${esc(roleName(u.adminRole))}</div><div class="muted small">${adminIsOnline(u)?'Онлайн':'Оффлайн'}</div></div></div><div class="admin-stat-grid" style="margin-top:12px">${[['ДЕНЬ','day'],['НЕДЕЛЯ','week'],['МЕСЯЦ','month'],['ГОД','year']].map(([label,key])=>`<div class="admin-stat-card"><div class="muted small">${label}</div><strong>${adminAnsweredReportsCount(u.id,key)}</strong><div class="muted small">вопросов</div></div>`).join('')}</div><div class="row" style="margin-top:12px"><b>Номера</b><div class="small">Всего: ${(u.inventory||[]).length} · Активных: ${active} · Деактивированных: ${inactive}</div><div class="stack" style="margin-top:8px">${(u.inventory||[]).map(p=>`<span class="tag-preview">${esc(p.code)}</span>`).join('')||'<span class="muted small">Нет номеров</span>'}</div></div><div class="row"><b>Теги</b><div class="stack" style="margin-top:8px">${tags.map(tagPreview).join('')||'<span class="muted small">Нет тегов</span>'}</div></div><div class="row"><b>История должностей</b><div class="list" style="margin-top:8px">${history.length?history.slice().reverse().map(h=>`<div class="small">${esc(roleName(h.role))} · назначил: ${esc(h.assignedBy||'Система')} · ${fmt(h.assignedAt)}</div>`).join(''):'<span class="muted small">Нет истории</span>'}</div></div></div>`}
function adminOnline(){const admins=load(KEYS.users,[]).filter(u=>roleLevel(u)>0);return `<div class="admin-tab active"><div class="section-title">ОНЛАЙН АДМИНИСТРАЦИИ</div><div class="list">${admins.map(u=>`<div class="row"><div class="row-main"><div><b>${esc(u.nickname)}</b><div class="muted small">${esc(roleName(u.adminRole))} · ID ${esc(u.accountId)}</div></div><span class="badge ${adminIsOnline(u)?'green':'red'}"><span class="online-dot ${adminIsOnline(u)?'on':''}"></span>${adminIsOnline(u)?'ОНЛАЙН':'ОФЛАЙН'}</span></div><div class="muted small" style="margin-top:7px">Последняя активность: ${u.lastSeen?fmt(u.lastSeen):'нет данных'}</div></div>`).join('')}</div></div>`}
function adminRoles(){if(!canManageRoles())return '<div class="notice muted">Только Owner может назначать должности администрации.</div>';const users=load(KEYS.users,[]);return `<div class="admin-tab active"><div class="section-title">ВЫДАЧА АДМИНКИ</div><div class="admin-form"><div class="field"><label>ИГРОК</label>${userSelect('roleUser')}</div><div class="field"><label>ДОЛЖНОСТЬ</label><select id="roleSelect">${Object.entries(ADMIN_ROLES).map(([key,name])=>`<option value="${key}">${name}</option>`).join('')}</select></div><div class="full"><button class="btn btn-blue" onclick="assignAdminRole()">НАЗНАЧИТЬ ДОЛЖНОСТЬ</button></div></div><div class="hr"></div><div class="section-title">АДМИНИСТРАЦИЯ</div><div class="list">${users.filter(u=>roleLevel(u)>0).map(u=>`<div class="row"><div class="row-main"><div><b>${esc(u.nickname)}</b><div class="muted small">ID ${esc(u.accountId)}</div></div><span class="role-pill">${esc(roleName(u.adminRole))}</span></div><div class="small" style="margin-top:8px">Назначил: ${esc(u.roleAssignedBy||'Система')} · ${fmt(u.roleAssignedAt||u.createdAt)}</div></div>`).join('')}</div></div>`}
function assignAdminRole(){if(!canManageRoles())return showToast('Только Owner может выдавать админки.');const target=findUserById(document.getElementById('roleUser').value);const role=document.getElementById('roleSelect').value;if(!target||!ADMIN_ROLES[role])return showToast('Выберите игрока и должность.');if(target.nickname.toLowerCase()===OWNER&&role!=='owner')return showToast('Для d0ntyyy должность всегда Owner.');target.admin=true;target.adminRole=role;target.roleAssignedBy=currentUser.nickname;target.roleAssignedAt=Date.now();target.adminHistory=Array.isArray(target.adminHistory)?target.adminHistory:[];target.adminHistory.push({role,assignedBy:currentUser.nickname,assignedAt:target.roleAssignedAt});updateUser(target);addMessage(target.id,'Вам выдали админ-права',`Вам назначена должность: ${roleName(role)}\nКто назначил: ${currentUser.nickname}`);showToast(`${target.nickname} назначен на должность «${roleName(role)}».`,true);renderAdmin()}
function adminPunishments(){if(!canManageProject())return '<div class="notice muted">Нет доступа.</div>';const owner=isOwnerUser();const canBan=canManageBans();return `<div class="admin-tab active"><div class="section-title">Выдать наказание</div><div class="admin-form"><div class="field"><label>ИГРОК</label>${userSelect()}</div><div class="field"><label>ТИП</label><select id="punType" onchange="updateBanFields()"><option value="warning">Предупреждение</option><option value="strike">Выговор</option><option value="ban" ${canBan?'':'disabled'}>Бан${canBan?'':' — только с Администратора'}</option></select></div><div class="field full" id="banReasonField" style="display:none"><label>ПРИЧИНА</label><select id="banTemplate" onchange="applyBanTemplate()"><option value="">Выберите причину</option><option value="illegalNumber">Нелегальное получение номеров — 7 дней</option><option value="illegalRare">Нелегальное получение редких номеров — 14 дней</option><option value="easter14">Пасхалка на маркете — 14 дней</option><option value="badNick">Некорректный ник (1.3) — 1 день</option><option value="fake">Фейк — навсегда</option><option value="custom">Своя причина</option></select></div><div class="field full" id="customReasonField" style="display:none"><label>СВОЯ ПРИЧИНА</label><textarea id="punReason" rows="3" placeholder="Введите причину"></textarea></div><div class="field full" id="durationField" style="display:none"><label>СРОК БАНА</label><select id="banDuration" onchange="toggleCustomDuration()"><option value="1">1 час</option><option value="24">1 день</option><option value="168">7 дней</option><option value="336">14 дней</option><option value="720">30 дней</option><option value="2160">90 дней</option><option value="4320">180 дней</option><option value="8760">365 дней</option><option value="forever" ${owner?'':'disabled'}>Навсегда${owner?'':' — только Owner'}</option><option value="custom">Свой срок</option></select></div><div class="field full" id="customDurationField" style="display:none"><label>СВОЙ СРОК</label><div class="tag-colors"><input id="customDurationAmount" type="number" min="1" placeholder="Количество"><select id="customDurationUnit"><option value="hour">Часов</option><option value="day">Дней</option></select></div></div><div class="full stack"><button class="btn btn-red" onclick="adminIssue()">ВЫДАТЬ</button></div></div><div class="hr"></div><div class="section-title">Активные наказания</div><div class="list">${renderActivePunishments()}</div></div>`}
function updateBanFields(){const ban=document.getElementById('punType')?.value==='ban';document.getElementById('banReasonField')?.style.setProperty('display',ban?'flex':'none');document.getElementById('durationField')?.style.setProperty('display',ban?'flex':'none');if(!ban){document.getElementById('customReasonField')?.style.setProperty('display','none');document.getElementById('customDurationField')?.style.setProperty('display','none')}}
function applyBanTemplate(){const v=document.getElementById('banTemplate')?.value;const map={illegalNumber:['Нелегальное получение номеров','168'],illegalRare:['Нелегальное получение редких номеров','336'],easter14:['Пасхалка на маркете','336'],badNick:['Некорректный ник (1.3)','24'],fake:['Фейк','forever'],custom:['','24']};if(!map[v])return;const [reason,dur]=map[v];const r=document.getElementById('punReason');if(r)r.value=reason;const d=document.getElementById('banDuration');if(d)d.value=dur;document.getElementById('customReasonField')?.style.setProperty('display',v==='custom'?'flex':'none');toggleCustomDuration()}
function toggleCustomDuration(){const custom=document.getElementById('banDuration')?.value==='custom';document.getElementById('customDurationField')?.style.setProperty('display',custom?'flex':'none')}
function getBanDurationHours(){const v=document.getElementById('banDuration')?.value;if(v==='forever')return null;if(v==='custom'){const amount=Number(document.getElementById('customDurationAmount')?.value);const unit=document.getElementById('customDurationUnit')?.value;if(!Number.isFinite(amount)||amount<=0)return -1;return amount*(unit==='day'?24:1)}const n=Number(v);return Number.isFinite(n)&&n>0?n:-1}
function adminIssue(){if(!canManageProject())return showToast('Нет доступа.');const target=findUserById(document.getElementById('punUser').value),type=document.getElementById('punType').value,tmpl=document.getElementById('banTemplate')?.value||'';let reason=(document.getElementById('punReason')?.value||'').trim();if(type==='ban'&&tmpl&&!reason)applyBanTemplate();reason=(document.getElementById('punReason')?.value||'').trim();if(type!=='ban'&&!reason)return showToast('Для предупреждения и выговора укажите причину.');if(type==='ban'&&!canManageBans())return showToast('Баны доступны только с должности «Администратор».');if(type==='ban'&&!reason)return showToast('Выберите причину.');if(type==='ban'){const hours=getBanDurationHours();if(hours===-1)return showToast('Укажите корректный срок.');if(hours===null&&!isOwnerUser())return showToast('Бан навсегда может выдавать только Owner.');const r=issuePunishment(target,type,reason,{durationHours:hours,durationDays:hours===null?null:hours/24});showToast(r.ok?'Наказание выдано.':r.msg,r.ok);if(r.ok)renderAdmin();return}const r=issuePunishment(target,type,reason,{});showToast(r.ok?'Наказание выдано.':r.msg,r.ok);if(r.ok)renderAdmin()}
function renderActivePunishments(){const all=activePunishmentsAll();if(!all.length)return '<div class="muted">Активных наказаний нет.</div>';return all.map(x=>{const u=findUserById(x.userId);return `<div class="row"><div class="row-main"><div><b>${esc(u?.nickname||'—')}</b><div class="muted small">${x.type==='warning'?'Предупреждение':x.type==='strike'?'Выговор':'Бан'} · ${esc(x.reason)}</div></div><span class="badge red">${x.expiresAt?fmt(x.expiresAt):'Навсегда'}</span></div><div class="small" style="margin-top:8px">Администратор: ${esc(x.admin)} · ID: <span class="mono">${x.id}</span></div><div class="stack" style="margin-top:9px"><button class="btn" onclick="removePunishment('${esc(x.id)}');renderAdmin()">СНЯТЬ</button></div></div>`}).join('')}
function activePunishmentsAll(){const now=Date.now();let p=load(KEYS.punishments,[]);let dirty=false;p=p.map(x=>{if(x.status==='active'&&x.expiresAt&&x.expiresAt<=now){x.status='expired';dirty=true}return x});if(dirty)save(KEYS.punishments,p);return p.filter(x=>x.status==='active')}
function adminNumbers(){if(!canManageProject())return '<div class="notice muted">Нет доступа.</div>';const users=load(KEYS.users,[]);const all=[];users.forEach(u=>(u.inventory||[]).forEach(p=>all.push({...p,owner:u})));return `<div class="admin-tab active"><div class="section-title">Выдача номера</div><div class="admin-form"><div class="field"><label>БУКВЫ</label><input id="giveLetters" maxlength="7" placeholder="AMR"></div><div class="field"><label>ЦИФРЫ</label><input id="giveNumbers" maxlength="3" inputmode="numeric" placeholder="111"></div><div class="field"><label>РЕГИОН</label><input id="giveRegion" maxlength="3" inputmode="numeric" placeholder="111"></div><div class="field"><label>КОМУ ВЫДАТЬ</label><select id="giveUser">${users.map(u=>`<option value="${esc(u.id)}">${esc(u.nickname)} — ${u.accountId}</option>`).join('')}</select></div><div class="full stack"><button class="btn btn-green" onclick="giveNumber()">ВЫДАТЬ НОМЕР</button></div></div><div class="hr"></div><div class="section-title">Все номера</div><div class="list">${all.length?all.map(x=>`<div class="row"><div class="row-main"><div><b>${esc(x.code)}</b><div class="muted small">${esc(x.owner.nickname)} — ${x.owner.accountId}</div></div><span class="badge ${x.active?'green':'red'}">${x.active?'АКТИВЕН':'ДЕАКТИВИРОВАН'}</span></div><div class="stack" style="margin-top:9px">${x.active?`<button class="btn btn-red" onclick="setPlateActive('${esc(x.owner.id)}','${esc(x.id)}',false)">ДЕАКТИВИРОВАТЬ</button>`:`<button class="btn btn-green" onclick="setPlateActive('${esc(x.owner.id)}','${esc(x.id)}',true)">АКТИВИРОВАТЬ</button>`}</div></div>`).join(''):'<div class="muted">Номеров пока нет.</div>'}</div></div>`}
function giveNumber(){if(!canManageProject())return showToast('Нет доступа.');let letters=normalizeLetters(document.getElementById('giveLetters').value),numbers=document.getElementById('giveNumbers').value.trim(),region=document.getElementById('giveRegion').value.trim(),target=findUserById(document.getElementById('giveUser').value);if(!validLetters(letters))return showToast('Буквы: ровно 3 буквы. Можно вводить AMR или АМР.');if(!valid3(numbers))return showToast('Цифры: ровно 3 цифры.');if(!valid3(region))return showToast('Регион: ровно 3 цифры.');if(!target)return showToast('Игрок не найден.');const code=makePlate(letters,numbers,region),key=plateKey(code);const users=load(KEYS.users,[]);if(users.some(u=>(u.inventory||[]).some(p=>plateKey(p.code)===key)))return showToast('Такой номер уже выдан.');target.inventory=target.inventory||[];target.inventory.push({id:crypto.randomUUID?crypto.randomUUID():String(Date.now()+Math.random()),code,active:true,createdAt:Date.now(),issuedBy:currentUser.nickname});updateUser(target);showToast(`Номер ${code} выдан игроку ${target.nickname}.`,true);renderAdmin()}
