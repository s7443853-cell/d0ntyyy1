function createTag(){if(!canManageTags())return showToast('Выдача и создание тегов недоступны для вашей должности.');const tag=document.getElementById('tagName').value.trim(),color=document.getElementById('tagColor').value,gradient=document.getElementById('tagGradient')?.checked||false,color2=document.getElementById('tagColor2')?.value||color;if(!tag)return showToast('Введите название тега.');if(!validHex(color)||!validHex(color2))return showToast('Некорректный цвет.');let tags=load(KEYS.tags,[]);tags.push({id:crypto.randomUUID?crypto.randomUUID():String(Date.now()+Math.random()),tag,color,color2:gradient?color2:color,gradient,createdAt:Date.now(),userId:null,userNick:null});save(KEYS.tags,tags);showToast(gradient?'Градиентный тег создан.':'Тег создан.',true);renderAdmin()}
